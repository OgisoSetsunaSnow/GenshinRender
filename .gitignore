# ============================================================================
#  Unity 工程 .gitignore
#  目标：clone 下来用 Unity 打开就能跑，不掺入本机缓存和过程产物
# ============================================================================

# ---------------------------------------------------------------------------
#  Unity 自动生成的目录（绝对不能提交，体积大且每台机器不同）
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 下载的原始包（如需要请自行保留）
/[Aa]ssets/AssetStoreTools*

# ---------------------------------------------------------------------------
#  IDE 自动生成的项目文件
#  clone 后 Unity 会重新生成，提交了反而会冲突
# ---------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

.vs/
.idea/
.gradle/

# VSCode：保留 .vscode/settings.json 这类团队共享配置的人可以删掉这行
.vscode/

# Rider
.idea/

# ---------------------------------------------------------------------------
#  构建产物
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# ---------------------------------------------------------------------------
#  崩溃 / 诊断
# ---------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
*.stackdump

# ---------------------------------------------------------------------------
#  操作系统垃圾文件
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
desktop.ini

# ---------------------------------------------------------------------------
#  本项目特有
# ---------------------------------------------------------------------------

# 过程截图（112 张，39MB，纯调试用，不属于工程资源）
/Assets/Screenshots/
/Assets/Screenshots.meta

# 材质备份（项目根的 _mat_backup，随时可由脚本重新生成）
/_mat_backup/
/_mat_backup.meta

# 第三方 MCP 工具包（4.8MB，与渲染无关，且需本机自行配置服务端）
# 如果团队需要共用，删掉这两行
/Packages/com.coplaydev.unity-mcp/
/Packages/com.coplaydev.unity-mcp.meta
